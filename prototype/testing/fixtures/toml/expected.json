{
  "config-example": {
    "companion": {},
    "permissions": {
      "level": "strict"
    },
    "workspace": {},
    "agent": {},
    "paid": {},
    "budget": {},
    "secrets": {}
  },
  "golden-friction": {
    "secrets": {
      "command": [
        "/bin/echo"
      ],
      "named": {
        "linear_mcp": "golden-linear-token"
      }
    },
    "mcp": {
      "servers": [
        {
          "id": "linear",
          "transport": "streamable_http",
          "url": "http://127.0.0.1:1/mcp",
          "minimum_clearance": "loopback",
          "auth": {
            "type": "bearer",
            "secret": "linear_mcp"
          },
          "tools": [
            {
              "name": "get_issue",
              "effect": "read",
              "approval": "allow"
            },
            {
              "name": "list_comments",
              "effect": "read",
              "approval": "allow"
            },
            {
              "name": "create_comment",
              "effect": "write_external",
              "approval": "ask"
            }
          ]
        }
      ]
    }
  },
  "mcp-adapter-documented": {
    "secrets": {
      "command": [
        "op",
        "read"
      ],
      "named": {
        "records_mcp": "op://vault/item/credential"
      }
    },
    "mcp": {
      "servers": [
        {
          "id": "records",
          "transport": "streamable_http",
          "url": "https://mcp.example.com/mcp",
          "minimum_clearance": "loopback",
          "auth": {
            "type": "bearer",
            "secret": "records_mcp"
          },
          "tools": [
            {
              "name": "read_record",
              "effect": "read",
              "approval": "allow"
            },
            {
              "name": "create_record_comment",
              "effect": "write_external",
              "approval": "ask"
            }
          ]
        }
      ]
    }
  },
  "mcp-adapter-linear-binding": {
    "secrets": {
      "command": [
        "secret-resolver"
      ],
      "named": {
        "linear_mcp": "fixture-pointer"
      }
    },
