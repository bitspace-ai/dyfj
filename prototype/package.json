{
  "name": "dyfj-prototype",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "test:file": "bash -c 'test $# -gt 0 || { echo \"usage: npm run test:file -- <path>... [--filter <pattern>]\" >&2; exit 2; }; exec node scripts/run-unit-tests.ts \"$@\"' dyfj-test-file",
    "test:golden": "node testing/golden/run.ts",
    "test:sandbox-acceptance": "node scripts/sandbox-acceptance.ts",
    "context-size-response": "node --env-file-if-exists=.env examples/context-size-response.ts",
    "model-response-modes": "node --env-file-if-exists=.env examples/model-response-modes.ts",
    "structured-output": "node --env-file-if-exists=.env examples/structured-output.ts",
    "structured-output-streaming": "node --env-file-if-exists=.env examples/structured-output-streaming.ts",
    "verify-workbench-events": "node --env-file-if-exists=.env examples/verify-workbench-events.ts",
    "smoke": "node examples/smoke-test.ts",
    "codex-chatgpt-login": "node scripts/codex-chatgpt-login.ts",
    "memory-recall-uat-fixture": "node scripts/memory-recall-uat-fixture.ts"
  },
  "dependencies": {
    "@agentclientprotocol/codex-acp": "2.5.0",
    "@agentclientprotocol/sdk": "1.8.0",
    "@anthropic-ai/sandbox-runtime": "0.0.81",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.3.1",
    "mysql2": "3.24.6",
    "smol-toml": "1.9.1",
    "ulid": "3.0.2",
    "zod": "4.6.7"
  }
}
