#!/bin/sh
# pre-push: refuse to publish commits that carry AI-tool attribution
# (AGENTS.md, Documentation Discipline). Checks the commits being pushed that
# no remote-tracking ref already has: their author, their committer, and
# their message lines (see lib/attribution.sh). This catches commits that
# skipped commit-msg (`--no-verify`) or were made before the hooks were
# enabled.
#
# Enable once per clone: git config core.hooksPath .githooks

set -eu

. "$(dirname "$0")/lib/attribution.sh"

all_zero() {
  case $1 in
    *[!0]*) return 1 ;;
    *) return 0 ;;
  esac
}

found=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  # A deleted ref publishes nothing.
  all_zero "$local_sha" && continue
  # Only commits no remote-tracking ref already has are newly published, so
  # merging main (whose history predates these hooks) never trips the check.
  commits=$(git rev-list "$local_sha" --not --remotes)
  for commit in $commits; do
    short=$(git rev-parse --short "$commit")
    for ident in "$(git log -1 --format='%an <%ae>' "$commit")" \
      "$(git log -1 --format='%cn <%ce>' "$commit")"; do
      if tool_identity "$ident"; then
        echo "pre-push: $short is attributed to '$ident'." >&2
        found=1
      fi
    done
    lines=$(git log -1 --format=%B "$commit")
    while IFS= read -r line; do
      if attribution_line "$line"; then
        echo "pre-push: $short carries tool attribution in its message." >&2
        found=1
        break
      fi
    done <<MSG
$lines
MSG
  done
done

if [ "$found" -ne 0 ]; then
  echo "Commits carry the maintainer's identity and no AI-tool attribution." >&2
  echo "Fix the unpushed commits (git commit --amend --reset-author for the" >&2
  echo "latest; git rebase with --exec for older ones), then push again." >&2
  exit 1
fi
