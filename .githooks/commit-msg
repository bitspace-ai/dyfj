#!/bin/sh
# commit-msg: keep AI-tool attribution out of git history (AGENTS.md,
# Documentation Discipline).
#
# 1. Refuses a commit whose configured author or committer is an AI tool
#    identity. GitHub turns every distinct commit author into a
#    Co-authored-by trailer when a pull request is squash-merged, so a commit
#    authored as a tool resurfaces as attribution on main even with a clean
#    message. git exports the pending author to hooks, so this covers
#    `git commit --author` too. `--no-verify` skips this hook; pre-push checks
#    the commits themselves.
# 2. Strips tool-attribution lines from the message (see lib/attribution.sh).
#
# Enable once per clone: git config core.hooksPath .githooks

set -eu

. "$(dirname "$0")/lib/attribution.sh"

msg_file=$1

for ident in "$(git var GIT_AUTHOR_IDENT)" "$(git var GIT_COMMITTER_IDENT)"; do
  who=$(ident_without_date "$ident")
  if tool_identity "$who"; then
    echo "commit-msg: refusing a commit attributed to '$who'." >&2
    echo "Commits carry the maintainer's identity, never an AI tool's. Set it with" >&2
    echo "  git config user.name 'Your Name'; git config user.email you@example.com" >&2
    echo "and, for a commit already made, amend it with --reset-author." >&2
    exit 1
  fi
done

tmp="$msg_file.tmp.$$"
trap 'rm -f "$tmp"' EXIT
while IFS= read -r line || [ -n "$line" ]; do
  attribution_line "$line" || printf '%s\n' "$line"
done <"$msg_file" >"$tmp"
# Drop the blank lines the removed lines leave at the end of the message.
sed -e ':a' -e '/^[[:space:]]*$/{$d;N;ba' -e '}' "$tmp" >"$msg_file"
