{
  "$comment": "Layer rules for the arch.imports lane (specs/01-architecture.md sections 3-4). Units are target directories under prototype/src. `files` maps modules that have not moved yet to their target unit by name; delete an entry when its file moves into the unit's directory. `outside` units are not part of the runtime graph: they may import runtime units, and runtime units may not import them.",
  "roots": [
    "prototype/src",
    "prototype/mcp",
    "prototype/scripts",
    "prototype/diagnostics"
  ],
  "sourceRoot": "prototype/src",
  "exclude": [".test.ts", ".fixture.ts"],
  "units": [
    { "dir": "kernel", "layer": 0 },
    { "dir": "contract", "layer": 1 },
    { "dir": "config", "layer": 1 },
    { "dir": "store", "layer": 2 },
    { "dir": "providers", "layer": 2 },
    { "dir": "tools", "layer": 2 },
    { "dir": "budget", "layer": 2 },
    { "dir": "context", "layer": 2 },
    { "dir": "transport", "layer": 2 },
    { "dir": "engine", "layer": 3 },
    { "dir": "runners/acp", "layer": 3 },
    { "dir": "runners/acp/codex", "layer": 3 },
    { "dir": "extensions/*", "layer": 4 },
    { "dir": "server", "layer": 5 },
    { "dir": "cli", "layer": 5 },
    { "dir": "mcp", "layer": 5, "path": "prototype/mcp" },
    {
      "dir": "diagnostics",
      "layer": 6,
      "outside": true,
      "path": "prototype/diagnostics"
    },
    {
      "dir": "tooling",
      "layer": 6,
      "outside": true,
      "path": "prototype/scripts"
    }
  ],
  "sameLayerEdges": [
    { "from": "context", "to": "providers", "typesOnly": true },
    { "from": "budget", "to": "store" },
    { "from": "tools", "to": "store" },
    { "from": "context", "to": "store" }
  ],
  "cli": {
    "unit": "cli",
    "allowedUnits": ["kernel", "contract", "config", "transport"],
    "allowedPaths": ["prototype/src/extensions/*/client.ts"]
  },
  "files": {
    "prototype/src/config.ts": "config",
    "prototype/src/secrets.ts": "config",
    "prototype/src/utils.ts": "store",
    "prototype/src/sessions.ts": "store",
    "prototype/src/provider.ts": "providers",
    "prototype/src/commands.ts": "tools",
    "prototype/src/file-tools.ts": "tools",
    "prototype/src/exec-tools.ts": "tools",
    "prototype/src/git-tools.ts": "tools",
    "prototype/src/mcp-tools.ts": "tools",
    "prototype/src/mcp-conformance.ts": "tools",
    "prototype/src/mcp-net-grants.ts": "tools",
    "prototype/src/web-tools.ts": "tools",
    "prototype/src/memory-search.ts": "tools",
    "prototype/src/memory.ts": "tools",
    "prototype/src/budget.ts": "budget",
    "prototype/src/repo-context.ts": "context",
    "prototype/src/prompts.ts": "context",
    "prototype/src/context-compression.ts": "context",
    "prototype/src/length-recovery.ts": "context",
    "prototype/src/jsonrpc.ts": "transport",
    "prototype/src/jsonrpc-peer.ts": "transport",
    "prototype/src/uds-path.ts": "transport",
    "prototype/src/uds-client.ts": "transport",
    "prototype/src/workbench.ts": "engine",
    "prototype/src/turn-runner.ts": "engine",
    "prototype/src/acp-client.ts": "runners/acp",
    "prototype/src/acp-session-map.ts": "runners/acp",
    "prototype/src/external-agent-runtime.ts": "runners/acp",
    "prototype/src/idea-packet.ts": "extensions/ideas",
    "prototype/src/friction.ts": "extensions/friction",
    "prototype/src/linear-tools.ts": "extensions/linear",
    "prototype/src/uds-server.ts": "server",
    "prototype/src/uds-serve.ts": "server",
    "prototype/src/cli.ts": "cli",
    "prototype/src/busy-spinner.ts": "cli",
    "prototype/src/streaming-markdown.ts": "cli",
    "prototype/src/runtime-sigint.ts": "cli",
    "prototype/src/model-response-modes.ts": "diagnostics",
    "prototype/src/context-size-response.ts": "diagnostics",
    "prototype/src/structured-output.ts": "diagnostics",
    "prototype/src/workbench-events.ts": "diagnostics"
  }
}
