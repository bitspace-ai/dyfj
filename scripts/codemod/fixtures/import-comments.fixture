# Comments inside a named import do not hide the specifiers after them. An
# import holding comments is not rewritten (its comments would be lost); the
# names it no longer needs are reported for removal by hand.
rules: assert.match, assert.equals
--- before
import {
  assertEquals, // equality
  assertMatch,
} from "@std/assert";

Deno.test("commented import", () => {
  assertEquals(1, 1);
  assertMatch("a", /a/);
});
--- after
import assert from "node:assert/strict";
import {
  assertEquals, // equality
  assertMatch,
} from "@std/assert";

Deno.test("commented import", () => {
  assert.deepStrictEqual(1, 1);
  assert.match("a", /a/);
});
--- findings
unconverted 2
