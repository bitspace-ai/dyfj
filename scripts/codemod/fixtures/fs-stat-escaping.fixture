# A stat result that leaves the expression (a then callback reading it, a
# catch passing it on, an argument) would have its is* fields read as
# always-truthy methods, so it is left for hand conversion. A then callback
# that ignores the result is safe.
rules: fs.stat
--- before
Deno.test("stat escapes", async () => {
  const exists = await Deno.stat("/tmp").then(() => true);
  await Deno.stat("/tmp").then((info) => info.isFile);
  const maybe = await Deno.stat("/tmp").catch(() => null);
  check(await Deno.stat("/tmp"));
  void [exists, maybe];
});
--- after
import { stat } from "node:fs/promises";

Deno.test("stat escapes", async () => {
  const exists = await stat("/tmp").then(() => true);
  await Deno.stat("/tmp").then((info) => info.isFile);
  const maybe = await Deno.stat("/tmp").catch(() => null);
  check(await Deno.stat("/tmp"));
  void [exists, maybe];
});
--- findings
unconverted 5
unconverted 6
unconverted 7
