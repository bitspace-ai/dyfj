# Sanitizer options stay with the registration until the runner moves.
rules:
--- before
Deno.test({
  name: "leaky",
  sanitizeResources: false,
  sanitizeOps: false,
  fn: () => {},
});
--- after
Deno.test({
  name: "leaky",
  sanitizeResources: false,
  sanitizeOps: false,
  fn: () => {},
});
--- findings
hand-review sanitizer-options 3
hand-review sanitizer-options 4
