# A private name (`#assertEquals`) is not the import, and a rest parameter
# (`...assertEquals`) declares the name: neither is rewritten.
rules:
--- before
import { assertEquals } from "@std/assert";

class Checker {
  #assertEquals(a: unknown, b: unknown) {
    return a === b;
  }
  run() {
    return this.#assertEquals(1, 2);
  }
}

function check(...assertEquals) {
  return assertEquals.length;
}

Deno.test("names", () => {
  assertEquals(new Checker().run(), check());
});
--- after
import { assertEquals } from "@std/assert";

class Checker {
  #assertEquals(a: unknown, b: unknown) {
    return a === b;
  }
  run() {
    return this.#assertEquals(1, 2);
  }
}

function check(...assertEquals) {
  return assertEquals.length;
}

Deno.test("names", () => {
  assertEquals(new Checker().run(), check());
});
--- findings
unconverted 12
unconverted 17
