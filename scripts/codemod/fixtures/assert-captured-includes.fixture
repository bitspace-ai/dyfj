# A bound value with a message substring: the helper checks the class, and an
# explicit assertion after the binding checks the substring.
rules: assert.import, assert.captured
captured-import: ../../testing/assertions/captured.ts
--- before
import { assertRejects, assertThrows } from "@std/assert";

Deno.test("includes", async () => {
  const error = assertThrows(() => boom(), TypeError, "bad input");
  const late = await assertRejects(
    () => later(),
    RangeError,
    "too late",
    "explains",
  );
  const plain = assertThrows(() => boom(), Error, undefined);
  void [error, late, plain];
});
--- after
import { captureRejection, captureThrow } from "../../testing/assertions/captured.ts";
import assert from "node:assert/strict";

Deno.test("includes", async () => {
  const error = captureThrow(() => boom(), TypeError);
  assert.ok(error.message.includes("bad input"));
  const late = await captureRejection(() => later(), RangeError);
  assert.ok(late.message.includes("too late"), "explains");
  const plain = captureThrow(() => boom(), Error);
  void [error, late, plain];
});
--- findings
