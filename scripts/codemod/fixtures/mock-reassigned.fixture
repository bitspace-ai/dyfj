# A spy name that is assigned again later may hold a spy the tool did not
# create, so none of its bindings convert and every read stays std.
rules:
--- before
import { spy } from "@std/testing/mock";

Deno.test("reassigned", () => {
  let callback = spy();
  callback = makeSpy();
  callback.restore();
});
--- after
import { spy } from "@std/testing/mock";

Deno.test("reassigned", () => {
  let callback = spy();
  callback = makeSpy();
  callback.restore();
});
--- findings
unconverted 4
