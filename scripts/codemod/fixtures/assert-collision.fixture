# A file that binds its own `assert` keeps its std assertions: importing
# node:assert/strict over the local binding would not compile.
rules:
--- before
import { assertRejects } from "@std/assert";

function assert(condition: boolean, message: string): asserts condition {
  if (!condition) throw new Error(message);
}

Deno.test("collision", async () => {
  assert(true, "local");
  await assertRejects(() => Promise.reject(new Error("x")));
});
--- after
import { assertRejects } from "@std/assert";

function assert(condition: boolean, message: string): asserts condition {
  if (!condition) throw new Error(message);
}

Deno.test("collision", async () => {
  assert(true, "local");
  await assertRejects(() => Promise.reject(new Error("x")));
});
--- findings
unconverted 9
