# An imported value bound to the host global's name shadows the global: its
# references are left for hand conversion.
rules:
--- before
import Deno from "./host.ts";

export function where(): string {
  return Deno.cwd();
}
--- after
import Deno from "./host.ts";

export function where(): string {
  return Deno.cwd();
}
--- findings
unconverted 1
unconverted 4
