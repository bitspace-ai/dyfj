# Registrations stay: the test registration and its context type, bdd describe
# and it, t.step and ignore. Mentions in comments and strings are listed so
# the runtime.neutral count can be lowered by hand.
rules:
--- before
import { describe, it } from "@std/testing/bdd";

// A comment that mentions Deno.cwd stays as written.
Deno.test({ name: "ignored", ignore: true, fn: () => {} });
Deno.test("steps", async (t: Deno.TestContext) => {
  await t.step("one", () => {});
});
describe("bdd", () => {
  it("runs", () => {
    const label = "Deno.env";
    void label;
  });
});
--- after
import { describe, it } from "@std/testing/bdd";

// A comment that mentions Deno.cwd stays as written.
Deno.test({ name: "ignored", ignore: true, fn: () => {} });
Deno.test("steps", async (t: Deno.TestContext) => {
  await t.step("one", () => {});
});
describe("bdd", () => {
  it("runs", () => {
    const label = "Deno.env";
    void label;
  });
});
--- findings
mention 3
mention 10
