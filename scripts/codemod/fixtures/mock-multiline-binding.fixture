# A spy bound across a line break converts like a one-line binding, so a
# name bound both ways converts everywhere, with its reads.
rules: mock.import, mock.spy, mock.restore
--- before
import { spy } from "@std/testing/mock";

Deno.test("one line", () => {
  const callback = spy();
  callback.restore();
});

Deno.test("two lines", () => {
  const callback =
    spy();
  callback.restore();
});
--- after
import { mock } from "node:test";

Deno.test("one line", () => {
  const callback = mock.fn();
  callback.mock.restore();
});

Deno.test("two lines", () => {
  const callback =
    mock.fn();
  callback.mock.restore();
});
--- findings
