# Child processes move to node:child_process by hand: a spawn failure arrives as
# an error event rather than a thrown error.
rules:
--- before
Deno.test("spawn", async () => {
  const output = await new Deno.Command("ln", { args: ["-s", "a", "b"] }).output();
  void output;
});
--- after
Deno.test("spawn", async () => {
  const output = await new Deno.Command("ln", { args: ["-s", "a", "b"] }).output();
  void output;
});
--- findings
hand-review command 2
