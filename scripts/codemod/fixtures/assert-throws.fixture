# assertThrows and assertRejects: the error class carries over; a message
# substring becomes a validation function.
rules: assert.import, assert.throws, assert.rejects
--- before
import { assertRejects, assertThrows } from "@std/assert";

Deno.test("throws", async () => {
  assertThrows(() => boom());
  assertThrows(() => boom(), TypeError);
  assertThrows(
    () => boom(),
    TypeError,
    "bad input",
  );
  assertThrows(() => boom(), Error, "bad input", "explains");
  assertThrows(() => boom(), TypeError, undefined, "explains");
  await assertRejects(() => later(), RangeError, "too late");
  await assertRejects(() => later());
  it("returns the rejection", () => assertRejects(() => later()));
});
--- after
import assert from "node:assert/strict";

Deno.test("throws", async () => {
  assert.throws(() => boom());
  assert.throws(() => boom(), TypeError);
  assert.throws(() => boom(), (error: unknown) => error instanceof TypeError && error.message.includes("bad input"));
  assert.throws(() => boom(), (error: unknown) => error instanceof Error && error.message.includes("bad input"), "explains");
  assert.throws(() => boom(), TypeError, "explains");
  await assert.rejects(() => later(), (error: unknown) => error instanceof RangeError && error.message.includes("too late"));
  await assert.rejects(() => later());
  it("returns the rejection", () => assert.rejects(() => later()));
});
--- findings
