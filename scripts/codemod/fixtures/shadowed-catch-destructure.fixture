# Catch parameters and destructured names also declare: a std name bound
# either way is shadowed, and its uses are left for hand conversion.
rules:
--- before
import { assertEquals, assertMatch } from "@std/assert";

Deno.test("catch and destructuring", () => {
  try {
    run();
  } catch (assertEquals) {
    void assertEquals;
  }
  {
    const { assertMatch } = helpers;
    assertMatch("a", /a/);
  }
  assertEquals(1, 1);
  assertMatch("b", /b/);
});
--- after
import { assertEquals, assertMatch } from "@std/assert";

Deno.test("catch and destructuring", () => {
  try {
    run();
  } catch (assertEquals) {
    void assertEquals;
  }
  {
    const { assertMatch } = helpers;
    assertMatch("a", /a/);
  }
  assertEquals(1, 1);
  assertMatch("b", /b/);
});
--- findings
unconverted 6
unconverted 7
unconverted 10
unconverted 11
unconverted 13
unconverted 14
