# Ordering assertions become assert.ok on the comparison, with a message that
# names both sides: values for bare names, source text for anything else.
rules: assert.import, assert.compare, assert.instance-of
--- before
import {
  assertGreater,
  assertGreaterOrEqual,
  assertInstanceOf,
  assertLess,
  assertLessOrEqual,
} from "@std/assert";

Deno.test("compare", () => {
  const size = 3;
  const limits = { max: 10 };
  assertLess(size, limits.max);
  assertLessOrEqual(size, 3, "within the cap");
  assertGreater(text().length, 0);
  assertGreaterOrEqual(size + 1, -1);
  assertInstanceOf(new Error("x"), Error);
  assertInstanceOf(value ?? fallback, TypeError, "a type error");
});
--- after
import assert from "node:assert/strict";

Deno.test("compare", () => {
  const size = 3;
  const limits = { max: 10 };
  assert.ok(size < limits.max, `expected ${size} < limits.max`);
  assert.ok(size <= 3, "within the cap");
  assert.ok(text().length > 0, `expected text().length > 0`);
  assert.ok((size + 1) >= -1, `expected size + 1 >= -1`);
  assert.ok((new Error("x")) instanceof Error);
  assert.ok((value ?? fallback) instanceof TypeError, "a type error");
});
--- findings
