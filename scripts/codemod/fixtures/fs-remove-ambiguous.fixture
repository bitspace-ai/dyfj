# The host's remove takes a file or an empty directory, while node's rm
# rejects any directory unless it is recursive. Only a remove that is
# provably recursive converts; the rest are left for hand conversion
# (unlink for a file, rmdir for an empty directory).
rules: fs.remove
--- before
Deno.test("remove", async () => {
  await Deno.remove("/tmp/tree", { recursive: true });
  await Deno.remove("/tmp/empty-dir");
  await Deno.remove("/tmp/file", { recursive: false });
  Deno.removeSync("/tmp/sync-tree", { recursive: true });
});
--- after
import { rmSync } from "node:fs";
import { rm } from "node:fs/promises";

Deno.test("remove", async () => {
  await rm("/tmp/tree", { recursive: true });
  await Deno.remove("/tmp/empty-dir");
  await Deno.remove("/tmp/file", { recursive: false });
  rmSync("/tmp/sync-tree", { recursive: true });
});
--- findings
unconverted 6
unconverted 7
