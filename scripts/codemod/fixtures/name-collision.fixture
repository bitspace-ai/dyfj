# A node: name that the file already binds is not imported over it.
rules: fs.mkdir
--- before
const rm = (path: string) => path;

Deno.test("collision", async () => {
  await Deno.mkdir("/tmp/x");
  await Deno.remove("/tmp/x");
  rm("/tmp/x");
});
--- after
import { mkdir } from "node:fs/promises";

const rm = (path: string) => path;

Deno.test("collision", async () => {
  await mkdir("/tmp/x");
  await Deno.remove("/tmp/x");
  rm("/tmp/x");
});
--- findings
unconverted 7
