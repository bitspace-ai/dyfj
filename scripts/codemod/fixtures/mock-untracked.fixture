# Spies and stubs the tool cannot follow to a name (held in an array, passed
# straight into a call) stay std ones, so their restore and call-record reads
# keep working; they are left for hand conversion.
rules: mock.stub, mock.restore
--- before
import { stub } from "@std/testing/mock";

Deno.test("untracked", () => {
  const warn = stub(console, "warn");
  const stubs = [stub(console, "log"), stub(console, "error")];
  try {
    console.warn("w");
  } finally {
    warn.restore();
    for (const s of stubs) s.restore();
  }
});
--- after
import { mock } from "node:test";
import { stub } from "@std/testing/mock";

Deno.test("untracked", () => {
  const warn = mock.method(console, "warn", () => {});
  const stubs = [stub(console, "log"), stub(console, "error")];
  try {
    console.warn("w");
  } finally {
    warn.mock.restore();
    for (const s of stubs) s.restore();
  }
});
--- findings
unconverted 6
unconverted 6
