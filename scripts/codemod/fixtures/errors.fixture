# Host error classes become error codes: an Error instance with the matching
# code (or name), both as an assertion's validation function and in place of
# an instanceof test. A plain object with the right code does not pass, and
# a caught null, undefined or primitive gives false, as instanceof does.
rules: errors.code, errors.not-capable, assert.import, assert.rejects, assert.throws, fs.read-text-file, fs.mkdir, fs.remove
--- before
import { assertRejects, assertThrows } from "@std/assert";

Deno.test("errors", async () => {
  await assertRejects(() => Deno.readTextFile("/missing"), Deno.errors.NotFound);
  assertThrows(() => Deno.mkdirSync("/tmp"), Deno.errors.AlreadyExists);
  try {
    await Deno.remove("/missing", { recursive: true });
  } catch (error) {
    if (!(error instanceof Deno.errors.NotFound)) throw error;
  }
  try {
    probe();
  } catch (error) {
    if (error instanceof Deno.errors.NotCapable) return;
  }
  const made = new Deno.errors.NotFound("x");
  void made;
});
--- after
import assert from "node:assert/strict";
import { mkdirSync } from "node:fs";
import { readFile, rm } from "node:fs/promises";

Deno.test("errors", async () => {
  await assert.rejects(() => readFile("/missing", "utf8"), (error: unknown) => error instanceof Error && (error as { code?: unknown }).code === "ENOENT");
  assert.throws(() => mkdirSync("/tmp"), (error: unknown) => error instanceof Error && (error as { code?: unknown }).code === "EEXIST");
  try {
    await rm("/missing", { recursive: true });
  } catch (error) {
    if (!((error instanceof Error && (error as { code?: unknown }).code === "ENOENT"))) throw error;
  }
  try {
    probe();
  } catch (error) {
    if ((error instanceof Error && (error as { name?: unknown }).name === "NotCapable")) return;
  }
  const made = new Deno.errors.NotFound("x");
  void made;
});
--- findings
unconverted 18
