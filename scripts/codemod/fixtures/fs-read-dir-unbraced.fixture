# An unbraced readDir loop's statement end cannot be found safely by text
# (a `;` in a string or a nested construct), so the loop is left for hand
# conversion.
rules:
--- before
Deno.test("unbraced", async () => {
  for await (const entry of Deno.readDir("/tmp")) console.log(";", entry.isFile);
});
--- after
Deno.test("unbraced", async () => {
  for await (const entry of Deno.readDir("/tmp")) console.log(";", entry.isFile);
});
--- findings
unconverted 2
