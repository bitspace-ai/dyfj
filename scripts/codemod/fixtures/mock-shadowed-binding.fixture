# A spy whose bound name is declared again elsewhere (a parameter here) is
# left std: the reads of the other binding cannot be told apart by text.
rules:
--- before
import { spy } from "@std/testing/mock";

function count(callback: { calls: unknown[] }) {
  return callback.calls.length;
}

Deno.test("shadowed spy", () => {
  const callback = spy();
  callback();
  void [count, callback.calls.length];
});
--- after
import { spy } from "@std/testing/mock";

function count(callback: { calls: unknown[] }) {
  return callback.calls.length;
}

Deno.test("shadowed spy", () => {
  const callback = spy();
  callback();
  void [count, callback.calls.length];
});
--- findings
unconverted 8
