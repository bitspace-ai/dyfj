# The host global reached through a global object, by member or by static
# bracket key, is still the host global: it is reported for hand conversion
# rather than passing silently or as a mere mention.
rules:
--- before
Deno.test("through globalThis", () => {
  const cwd = globalThis.Deno.cwd();
  const bracketed = globalThis["Deno"].cwd();
  void [cwd, bracketed];
});
--- after
Deno.test("through globalThis", () => {
  const cwd = globalThis.Deno.cwd();
  const bracketed = globalThis["Deno"].cwd();
  void [cwd, bracketed];
});
--- findings
unconverted 2
unconverted 3
mention 3
