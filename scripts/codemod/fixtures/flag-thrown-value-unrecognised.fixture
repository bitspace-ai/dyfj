# Shapes the captured rule does not recognise stay flagged: the value passed
# on, held in an array or returned; a substring check outside a binding; an
# unawaited rejection with a substring; an assertion message without a class.
rules:
captured-import: ../../testing/assertions/captured.ts
--- before
import { assertRejects, assertThrows } from "@std/assert";

Deno.test("left", async () => {
  consume(assertThrows(() => boom()));
  const errors = [assertThrows(() => boom())];
  const capture = () => assertThrows(() => boom());
  const message = (assertThrows(() => boom(), Error, "bad") as Error).message;
  const pending = assertRejects(() => later(), Error, "late");
  const labelled = assertThrows(() => boom(), "explains");
  void [errors, capture, message, pending, labelled];
});
--- after
import { assertRejects, assertThrows } from "@std/assert";

Deno.test("left", async () => {
  consume(assertThrows(() => boom()));
  const errors = [assertThrows(() => boom())];
  const capture = () => assertThrows(() => boom());
  const message = (assertThrows(() => boom(), Error, "bad") as Error).message;
  const pending = assertRejects(() => later(), Error, "late");
  const labelled = assertThrows(() => boom(), "explains");
  void [errors, capture, message, pending, labelled];
});
--- findings
hand-review thrown-value-used 4
hand-review thrown-value-used 5
hand-review thrown-value-used 6
hand-review thrown-value-used 7
hand-review thrown-value-used 8
hand-review thrown-value-used 9
