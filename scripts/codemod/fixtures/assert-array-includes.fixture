# assertArrayIncludes on a bare name and a literal list of expected items:
# the assertion names the items that are missing. Primitive items match with
# includes, other items deeply, as std does. A member chain or computed list
# would be evaluated once per item, so it is left for hand review.
rules: assert.array-includes
--- before
import { assertArrayIncludes } from "@std/assert";

Deno.test("array includes", () => {
  const stderr = ["a", "b"];
  const item = { tags: ["x"] };
  assertArrayIncludes(stderr, ["a"]);
  assertArrayIncludes(parsed.permissions["serve-unix"].run as string[], [
    "/bin/kill",
    "/bin/sleep",
  ]);
  assertArrayIncludes(item.tags, ["x"], "tagged");
  assertArrayIncludes(messages, [{ role: "tool", content: "" }]);
  assertArrayIncludes(lines(), ["a"]);
});
--- after
import assert from "node:assert/strict";
import { isDeepStrictEqual } from "node:util";
import { assertArrayIncludes } from "@std/assert";

Deno.test("array includes", () => {
  const stderr = ["a", "b"];
  const item = { tags: ["x"] };
  assert.deepStrictEqual(["a"].filter((item) => !stderr.includes(item)), []);
  assertArrayIncludes(parsed.permissions["serve-unix"].run as string[], [
    "/bin/kill",
    "/bin/sleep",
  ]);
  assertArrayIncludes(item.tags, ["x"], "tagged");
  assert.deepStrictEqual([{ role: "tool", content: "" }].filter((item) => !messages.some((candidate) => isDeepStrictEqual(candidate, item))), []);
  assertArrayIncludes(lines(), ["a"]);
});
--- findings
unconverted 9
unconverted 13
unconverted 15
