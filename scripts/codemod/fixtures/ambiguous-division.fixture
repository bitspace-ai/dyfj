# A `/` after a `}` is read as a regex when one parses, also across a line
# break, and every such reading is reported. A std name inside the span
# keeps its import, in case the `/` is really division and the name runs.
rules: assert.equals
--- before
import { assertEquals } from "@std/assert";

Deno.test("cross-line division", () => {
  const n = { valueOf() { return 8; } }
    / assertEquals(4, 4) / 1;
  assertEquals(n, n);
});
--- after
import assert from "node:assert/strict";
import { assertEquals } from "@std/assert";

Deno.test("cross-line division", () => {
  const n = { valueOf() { return 8; } }
    / assertEquals(4, 4) / 1;
  assert.deepStrictEqual(n, n);
});
--- findings
unconverted 6
