# Factories the rule cannot prove return a convertible spy keep their std
# creation, and the names bound from them keep their std reads: a declared
# return type (it names the std type), more than one return, a return inside
# a nested block, an async factory, a creation the tool would not convert,
# a result read or held by `using` where it is made, and a result bound to a
# name the file also binds as something else.
rules:
--- before
import { assertSpyCalls, spy } from "@std/testing/mock";

function typed(): Recorder {
  return spy();
}

function either(flag: boolean) {
  if (flag) return spy();
  return spy(() => 1);
}

function nested(flag: boolean) {
  if (flag) {
    return spy();
  }
}

async function later() {
  return spy();
}

function generic() {
  return spy<() => void>();
}

function read() {
  return spy();
}

function held() {
  return spy();
}

function shared() {
  return spy();
}

function check(confirm: unknown) {
  void confirm;
}

Deno.test("unproven", async () => {
  const a = typed();
  const b = either(true);
  const c = nested(true);
  const d = await later();
  const e = generic();
  void read().calls;
  using f = held();
  const confirm = shared();
  assertSpyCalls(a, 0);
  assertSpyCalls(b, 0);
  assertSpyCalls(c!, 0);
  assertSpyCalls(d, 0);
  assertSpyCalls(e, 0);
  assertSpyCalls(f, 0);
  assertSpyCalls(confirm, 0);
  check(confirm);
});
--- after
import { assertSpyCalls, spy } from "@std/testing/mock";

function typed(): Recorder {
  return spy();
}

function either(flag: boolean) {
  if (flag) return spy();
  return spy(() => 1);
