function nested(flag: boolean) {
  if (flag) {
    return spy();
  }
}

async function later() {
  return spy();
}

function generic() {
  return spy<() => void>();
}

function read() {
  return spy();
}

function held() {
  return spy();
}

function shared() {
  return spy();
}

function check(confirm: unknown) {
  void confirm;
}

Deno.test("unproven", async () => {
  const a = typed();
  const b = either(true);
  const c = nested(true);
  const d = await later();
  const e = generic();
  void read().calls;
  using f = held();
  const confirm = shared();
  assertSpyCalls(a, 0);
  assertSpyCalls(b, 0);
  assertSpyCalls(c!, 0);
  assertSpyCalls(d, 0);
  assertSpyCalls(e, 0);
  assertSpyCalls(f, 0);
  assertSpyCalls(confirm, 0);
  check(confirm);
});
