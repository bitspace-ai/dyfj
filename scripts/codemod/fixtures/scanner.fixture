# Only code is rewritten: names inside strings, templates, comments and regex
# literals are left alone (a regex can follow a control statement's closing
# parenthesis), while code inside template substitutions is not. A `/` after
# a postfix ++ or -- divides. A `/` after a `}` on the same line is read as a
# regex when one parses there, and reported, since an object literal could
# also stand there. A std name inside such a span keeps its import.
rules: assert.equals
--- before
// A header comment before the imports.
import { assertEquals } from "@std/assert";

Deno.test("scanner", () => {
  const quoted = "assertEquals(1, 2)";
  const single = 'it\'s assertEquals(';
  // assertEquals(3, 4) in a comment
  /* assertEquals(5, 6) */
  const pattern = /assertEquals\(/;
  const template = `assertEquals(7, 8) ${String(assertEquals(1, 1))} done`;
  const ratio = 4 / 2 / 1;
  let count = 1;
  const halves = count++ / 2 / 1;
  const quarter = count-- / assertEquals(4, 4) / 1;
  if (ratio) /assertEquals(.*)/.test(quoted);
  while (false) /assertEquals/.exec(quoted);
  if (ratio) {}
  /assertEquals\(/.test(quoted);
  if (ratio) {} /assertEquals(1, 2)/.test(quoted);
  const n = { valueOf() { return 4; } } / ratio / 1;
  for await (const x of [quoted]) /assertEquals(1, 2)/.test(x);
  assertEquals(ratio, 2);
  void [quoted, single, pattern, template, halves, quarter, n];
});
--- after
// A header comment before the imports.
import assert from "node:assert/strict";
import { assertEquals } from "@std/assert";

Deno.test("scanner", () => {
  const quoted = "assertEquals(1, 2)";
  const single = 'it\'s assertEquals(';
  // assertEquals(3, 4) in a comment
  /* assertEquals(5, 6) */
  const pattern = /assertEquals\(/;
  const template = `assertEquals(7, 8) ${String(assert.deepStrictEqual(1, 1))} done`;
  const ratio = 4 / 2 / 1;
  let count = 1;
  const halves = count++ / 2 / 1;
  const quarter = count-- / assert.deepStrictEqual(4, 4) / 1;
  if (ratio) /assertEquals(.*)/.test(quoted);
  while (false) /assertEquals/.exec(quoted);
  if (ratio) {}
  /assertEquals\(/.test(quoted);
  if (ratio) {} /assertEquals(1, 2)/.test(quoted);
  const n = { valueOf() { return 4; } } / ratio / 1;
  for await (const x of [quoted]) /assertEquals(1, 2)/.test(x);
  assert.deepStrictEqual(ratio, 2);
  void [quoted, single, pattern, template, halves, quarter, n];
});
--- findings
unconverted 19
unconverted 20
unconverted 21
