# When some binding of a spy's name cannot convert (here a spy with three
# arguments), none of the same-name bindings convert: their reads cannot be
# told apart by text.
rules:
--- before
import { spy } from "@std/testing/mock";

Deno.test("one", () => {
  const callback = spy();
  callback.restore();
});

Deno.test("two", () => {
  const callback = spy(a, b, c);
  callback.restore();
});
--- after
import { spy } from "@std/testing/mock";

Deno.test("one", () => {
  const callback = spy();
  callback.restore();
});

Deno.test("two", () => {
  const callback = spy(a, b, c);
  callback.restore();
});
--- findings
unconverted 4
unconverted 9
