# When the std `assert` is also used as a value, that use stays std, so the
# std import keeps its `assert` binding and node:assert/strict cannot be
# imported under the same name: the file's assertions are left for hand
# conversion.
rules:
--- before
import { assert, assertEquals } from "@std/assert";

Deno.test("value use", () => {
  const check = assert;
  check(true);
  assertEquals(1, 1);
});
--- after
import { assert, assertEquals } from "@std/assert";

Deno.test("value use", () => {
  const check = assert;
  check(true);
  assertEquals(1, 1);
});
--- findings
unconverted 4
unconverted 6
