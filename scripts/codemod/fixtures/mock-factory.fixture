# A spy made by a factory declared in the same file, a function or an arrow
# whose only return is a spy or stub creation: the creation converts, and so
# do the reads and spy assertions on every name bound from a call to it. A
# call passed straight on, unnamed, has no reads to rewrite.
rules: mock.import, mock.spy, mock.stub, mock.calls, mock.restore, mock.assert-spy-calls
--- before
import { assertSpyCalls, spy, stub } from "@std/testing/mock";

function approving() {
  return spy(
    (_warning: string): Promise<string> => Promise.resolve("approve"),
  );
}

const recorder = () =>
  spy((_input: unknown) => Promise.resolve(undefined));

const quieted = () => {
  return stub(console, "warn");
};

Deno.test("factories", async () => {
  const confirm = approving();
  const record = recorder();
  const warn = quieted();
  await confirm("w");
  await run({ record, extra: recorder() }, approving());
  assertSpyCalls(confirm, 1);
  assertSpyCalls(record, 0);
  void record.calls.length;
  warn.restore();
});

Deno.test("a direct binding of the same name", () => {
  const confirm = spy((_warning: string) => Promise.resolve("deny"));
  assertSpyCalls(confirm, 0);
});
--- after
import assert from "node:assert/strict";
import { mock } from "node:test";

function approving() {
  return mock.fn(
    (_warning: string): Promise<string> => Promise.resolve("approve"),
  );
}

const recorder = () =>
  mock.fn((_input: unknown) => Promise.resolve(undefined));

const quieted = () => {
  return mock.method(console, "warn", () => {});
};

Deno.test("factories", async () => {
  const confirm = approving();
  const record = recorder();
  const warn = quieted();
  await confirm("w");
  await run({ record, extra: recorder() }, approving());
  assert.equal(confirm.mock.callCount(), 1);
  assert.equal(record.mock.callCount(), 0);
  void record.mock.callCount();
  warn.mock.restore();
});

Deno.test("a direct binding of the same name", () => {
  const confirm = mock.fn((_warning: string) => Promise.resolve("deny"));
  assert.equal(confirm.mock.callCount(), 0);
});
--- findings
