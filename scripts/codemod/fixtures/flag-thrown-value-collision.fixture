# A file that already binds the helper's name keeps the flag.
rules:
captured-import: ../../testing/assertions/captured.ts
--- before
import { assertThrows } from "@std/assert";

function captureThrow() {}

Deno.test("collision", () => {
  const error = assertThrows(() => boom());
  void [error, captureThrow];
});
--- after
import { assertThrows } from "@std/assert";

function captureThrow() {}

Deno.test("collision", () => {
  const error = assertThrows(() => boom());
  void [error, captureThrow];
});
--- findings
hand-review thrown-value-used 6
