# A method declared with a std name is a declaration, not a call: its header
# is left alone, while real calls still convert.
rules: assert.equals
--- before
import { assertEquals } from "@std/assert";

const checker = {
  assertEquals(a: unknown, b: unknown) {
    return a === b;
  },
};

Deno.test("method named like an assertion", () => {
  assertEquals(checker.assertEquals(1, 1), true);
});
--- after
import assert from "node:assert/strict";
import { assertEquals } from "@std/assert";

const checker = {
  assertEquals(a: unknown, b: unknown) {
    return a === b;
  },
};

Deno.test("method named like an assertion", () => {
  assert.deepStrictEqual(checker.assertEquals(1, 1), true);
});
--- findings
