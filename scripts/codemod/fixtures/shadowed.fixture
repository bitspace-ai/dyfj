# A std name that the file also declares (a parameter, a local) is shadowed
# somewhere, and text rules cannot tell which uses are which, so its uses are
# left for hand conversion. Other names convert as usual.
rules: assert.import, assert.strict-equals
--- before
import { assertEquals, assertStrictEquals } from "@std/assert";

const check = (assertEquals: (a: unknown, b: unknown) => void) =>
  assertEquals(1, 1);

Deno.test("shadowed", () => {
  check(() => {});
  assertEquals(2, 2);
  assertStrictEquals(3, 3);
});
--- after
import assert from "node:assert/strict";
import { assertEquals } from "@std/assert";

const check = (assertEquals: (a: unknown, b: unknown) => void) =>
  assertEquals(1, 1);

Deno.test("shadowed", () => {
  check(() => {});
  assertEquals(2, 2);
  assert.strictEqual(3, 3);
});
--- findings
unconverted 4
unconverted 5
unconverted 9
