# A stub held by `using` restores itself at scope exit; node's mocks do not, so
# it is left for a hand-written try/finally.
rules:
--- before
import { assertSpyCalls, stub } from "@std/testing/mock";

Deno.test("using", () => {
  using warn = stub(console, "warn");
  console.warn("x");
  assertSpyCalls(warn, 1);
});
--- after
import { assertSpyCalls, stub } from "@std/testing/mock";

Deno.test("using", () => {
  using warn = stub(console, "warn");
  console.warn("x");
  assertSpyCalls(warn, 1);
});
--- findings
hand-review using-mock 4
unconverted 6
