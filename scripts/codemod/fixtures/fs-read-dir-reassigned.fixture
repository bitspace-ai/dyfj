# A readDir loop whose body assigns the entry name holds something else in
# it afterwards, so the loop is left for hand conversion.
rules:
--- before
Deno.test("readDir reassigned", async () => {
  for await (let entry of Deno.readDir("/tmp")) {
    entry = other;
    void entry.isFile;
  }
});
--- after
Deno.test("readDir reassigned", async () => {
  for await (let entry of Deno.readDir("/tmp")) {
    entry = other;
    void entry.isFile;
  }
});
--- findings
unconverted 2
