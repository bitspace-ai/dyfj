# The host's mkdir resolves to nothing; node's recursive mkdir resolves to the
# first directory it created. A call whose value is used is left for hand
# conversion; a call used as a statement converts.
rules: fs.mkdir
--- before
Deno.test("mkdir", async () => {
  await Deno.mkdir("/tmp/a", { recursive: true });
  const made = await Deno.mkdir("/tmp/b", { recursive: true });
  const sync = Deno.mkdirSync("/tmp/c", { recursive: true });
  void [made, sync];
});
--- after
import { mkdir } from "node:fs/promises";

Deno.test("mkdir", async () => {
  await mkdir("/tmp/a", { recursive: true });
  const made = await Deno.mkdir("/tmp/b", { recursive: true });
  const sync = Deno.mkdirSync("/tmp/c", { recursive: true });
  void [made, sync];
});
--- findings
unconverted 5
unconverted 6
