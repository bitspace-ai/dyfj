# An existing import of the target module that holds comments is never
# re-rendered (its comments would be lost): the new names get their own line.
rules: fs.mkdir
--- before
import {
  readFile, // used for fixtures
} from "node:fs/promises";

Deno.test("merge", async () => {
  await Deno.mkdir("/tmp/x", { recursive: true });
  void readFile;
});
--- after
import { mkdir } from "node:fs/promises";
import {
  readFile, // used for fixtures
} from "node:fs/promises";

Deno.test("merge", async () => {
  await mkdir("/tmp/x", { recursive: true });
  void readFile;
});
--- findings
