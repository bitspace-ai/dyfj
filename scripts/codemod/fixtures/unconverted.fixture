# Symbols and calls with no rule are left in place and listed by line, as is
# assertAlmostEquals in a file that cannot import its helper.
rules: assert.import, assert.equals
--- before
import { assertAlmostEquals, assertEquals } from "@std/assert";

Deno.test("leftovers", async () => {
  const file = await Deno.makeTempFile();
  assertAlmostEquals(0.1 + 0.2, 0.3);
  assertEquals(Deno.args.length, 0);
  const env = Deno.env;
  void [file, env];
});
--- after
import assert from "node:assert/strict";
import { assertAlmostEquals } from "@std/assert";

Deno.test("leftovers", async () => {
  const file = await Deno.makeTempFile();
  assertAlmostEquals(0.1 + 0.2, 0.3);
  assert.deepStrictEqual(Deno.args.length, 0);
  const env = Deno.env;
  void [file, env];
});
--- findings
unconverted 5
unconverted 6
unconverted 7
unconverted 8
