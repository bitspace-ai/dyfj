# A readDir loop whose body declares its entry name again (a callback
# parameter here) is left for hand conversion: the body's is* reads cannot
# be told apart by text.
rules:
--- before
Deno.test("readDir shadowed", async () => {
  for await (const entry of Deno.readDir("/tmp")) {
    const values = [entry];
    void values.map((entry) => entry.isFile);
  }
});
--- after
Deno.test("readDir shadowed", async () => {
  for await (const entry of Deno.readDir("/tmp")) {
    const values = [entry];
    void values.map((entry) => entry.isFile);
  }
});
--- findings
unconverted 2
