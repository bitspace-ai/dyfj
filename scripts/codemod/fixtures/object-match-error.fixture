# assertObjectMatch compares nested values with std equality, which tells
# two same-message Errors apart; partialDeepStrictEqual does not. A match
# with an Error-shaped operand is left for hand review.
rules:
--- before
import { assertObjectMatch } from "@std/assert";

Deno.test("object match with errors", () => {
  assertObjectMatch({ error: new Error("x") }, { error: new Error("x") });
});
--- after
import { assertObjectMatch } from "@std/assert";

Deno.test("object match with errors", () => {
  assertObjectMatch({ error: new Error("x") }, { error: new Error("x") });
});
--- findings
hand-review error-equality 4
