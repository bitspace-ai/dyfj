# With no node: import, the node:test import goes before the first import;
# a multi-line registration keeps its layout.
rules: registration.test
--- before
// A header comment.
import { thing } from "./thing.ts";

Deno.test(
  "a long name that the formatter wrapped",
  async function () {
    thing();
  },
);
--- after
// A header comment.
import { test } from "node:test";
import { thing } from "./thing.ts";

test(
  "a long name that the formatter wrapped",
  async function () {
    thing();
  },
);
--- findings
