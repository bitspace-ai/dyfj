# A test function that is not inline, or whose parameter is not a plain
# context, is converted by hand; so is a hook that takes a parameter.
rules:
--- before
import { beforeEach, describe } from "@std/testing/bdd";

Deno.test("destructured", ({ step }) => step);
Deno.test("by reference", named);
describe("suite", () => {
  beforeEach((t) => void t);
});

function named() {}
--- after
import { beforeEach, describe } from "@std/testing/bdd";

Deno.test("destructured", ({ step }) => step);
Deno.test("by reference", named);
describe("suite", () => {
  beforeEach((t) => void t);
});

function named() {}
--- findings
hand-review test-function 3
hand-review test-function 4
hand-review test-function 6
