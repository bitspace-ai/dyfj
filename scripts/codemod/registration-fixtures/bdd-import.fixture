# A bdd import becomes a node:test import in its place.
rules: registration.bdd-import
--- before
import assert from "node:assert/strict";
import { describe, it } from "@std/testing/bdd";

describe("suite", () => {
  it("case", () => {
    assert.ok(true);
  });
});
--- after
import assert from "node:assert/strict";
import { describe, it } from "node:test";

describe("suite", () => {
  it("case", () => {
    assert.ok(true);
  });
});
--- findings
