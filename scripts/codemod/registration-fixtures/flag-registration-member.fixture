# .ignore, .only and a registration passed as a value are converted by hand.
rules:
--- before
import { describe, it } from "@std/testing/bdd";

Deno.test.ignore("ignored", () => {});
describe("suite", () => {
  it.only("only", () => {});
});
const register = it;
--- after
import { describe, it } from "@std/testing/bdd";

Deno.test.ignore("ignored", () => {});
describe("suite", () => {
  it.only("only", () => {});
});
const register = it;
--- findings
hand-review registration-member 3
hand-review registration-member 5
hand-review registration-member 7
