# A bdd import merges into an existing node:test import, whose names are
# kept; the bdd line goes.
rules: registration.bdd-import
--- before
import assert from "node:assert/strict";
import {
  mock,
  type Mock,
} from "node:test";
import { describe, it } from "jsr:@std/testing@1/bdd";

describe("suite", () => {
  it("case", () => {
    const fn: Mock<() => void> = mock.fn();
    fn();
    assert.equal(fn.mock.callCount(), 1);
  });
});
--- after
import assert from "node:assert/strict";
import { describe, it, mock, type Mock } from "node:test";

describe("suite", () => {
  it("case", () => {
    const fn: Mock<() => void> = mock.fn();
    fn();
    assert.equal(fn.mock.callCount(), 1);
  });
});
--- findings
