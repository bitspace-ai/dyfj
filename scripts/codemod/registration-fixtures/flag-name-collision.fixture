# A file that already uses the name test is converted by hand.
rules:
--- before
const test = (s: string) => s.length > 0;

Deno.test("uses test", () => {
  void test("x");
});
--- after
const test = (s: string) => s.length > 0;

Deno.test("uses test", () => {
  void test("x");
});
--- findings
hand-review name-collision 1
