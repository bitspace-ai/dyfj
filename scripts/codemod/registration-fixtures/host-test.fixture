# The host's test function becomes node:test's, imported after the last
# node: import.
rules: registration.test
--- before
import assert from "node:assert/strict";
import { stripAnsiEscapes } from "./ansi.ts";

Deno.test("strips CSI", () => {
  assert.equal(stripAnsiEscapes("x"), "x");
});

Deno.test("strips OSC", async () => {
  await Promise.resolve();
  assert.ok(/a/.test("a"));
});
--- after
import assert from "node:assert/strict";
import { test } from "node:test";
import { stripAnsiEscapes } from "./ansi.ts";

test("strips CSI", () => {
  assert.equal(stripAnsiEscapes("x"), "x");
});

test("strips OSC", async () => {
  await Promise.resolve();
  assert.ok(/a/.test("a"));
});
--- findings
