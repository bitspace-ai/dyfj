{
  "schema": "dyfj.dependency.policy.manifest",
  "version": 1,
  "surfaces": [
    {
      "id": "deno.workspace",
      "source_class": "deno-registry",
      "manifest_paths": [
        "deno.json",
        "prototype/deno.json"
      ],
      "lock_paths": [
        "prototype/deno.lock"
      ],
      "required_evidence_classes": [
        "inspect-result",
        "selected-version",
        "publication-timestamp",
        "minimum-release-age",
        "manifest-diff",
        "lock-diff",
        "clean-room-resolution",
        "operator-inspect-before-apply"
      ],
      "age_policy": {
        "class": "registry-minimum-hours",
        "minimum_hours": 72
      },
      "mutable_references_allowed": false,
      "integrity_evidence_classes": [
        "exact-version-pin",
        "lockfile-integrity-hash"
      ],
      "provenance_evidence_classes": [
        "registry-source-provenance"
      ],
      "clean_room_check_ids": [
        "dependency.policy",
        "test.aggregate"
      ],
      "known_missing_evidence_classes": []
    },
