{
  "tasks": {
    "workbench": "deno task --cwd prototype workbench",
    "serve-unix": "deno task --cwd prototype serve-unix",
    "cli": "deno task --cwd prototype cli",
    "context-size-response": "deno task --cwd prototype context-size-response",
    "model-response-modes": "deno task --cwd prototype model-response-modes",
    "structured-output": "deno task --cwd prototype structured-output",
    "structured-output-streaming": "deno task --cwd prototype structured-output-streaming",
    "test": "DENO_BIN=$(deno run prototype/scripts/deno-executable.ts) && DENO_BIN=\"$DENO_BIN\" deno run --allow-env=PATH,HOME,TMPDIR,TEMP,TMP,CARGO_HOME,RUSTUP_HOME,DENO_BIN --allow-read=. --allow-write=/tmp,/private/tmp,/var/folders,/private/var/folders --allow-run=\"$DENO_BIN,cargo,dolt\" --allow-net=127.0.0.1 scripts/aggregate-test-gate.ts",
    "test:schema": "deno test --allow-read=schema schema/validate-schema.test.ts",
    "validate-schema": "deno run --allow-read=schema --allow-write=/tmp,/private/tmp,/var/folders,/private/var/folders --allow-run=dolt schema/validate-schema.ts",
    "verify-workbench-events": "deno task --cwd prototype verify-workbench-events"
  }
}
