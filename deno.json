{
  "nodeModulesDir": "manual",
  "compilerOptions": {
    "strict": true
  },
  "lock": {
    "frozen": true
  },
  "tasks": {
    "test": "npm test",
    "test:fast": "npm run test:fast",
    "test:schema": "deno run --no-prompt --allow-env=PATH,HOME,TMPDIR,TEMP,TMP,NODE_V8_COVERAGE --allow-read=. --allow-run=node scripts/run-node-test-files.ts --lane schema schema/validate-schema.test.ts schema/codegen.test.ts schema/equivalence.test.ts schema/model-catalog.test.ts",
    "validate-schema": "deno run --allow-env=PATH,HOME,TMPDIR,TEMP,TMP,NODE_V8_COVERAGE --allow-read=schema,/tmp,/private/tmp,/var/folders,/private/var/folders --allow-write=/tmp,/private/tmp,/var/folders,/private/var/folders --allow-run=dolt schema/validate-schema.ts",
    "schema:codegen": "deno run --allow-env=PATH,HOME,TMPDIR,TEMP,TMP,NODE_V8_COVERAGE --allow-read=schema,prototype/src/store/generated,/tmp,/private/tmp,/var/folders,/private/var/folders --allow-write=/tmp,/private/tmp,/var/folders,/private/var/folders,prototype/src/store/generated --allow-run=dolt schema/codegen.ts",
    "schema:equivalence": "deno run --allow-env=PATH,HOME,TMPDIR,TEMP,TMP,NODE_V8_COVERAGE --allow-read=schema,/tmp,/private/tmp,/var/folders,/private/var/folders --allow-write=/tmp,/private/tmp,/var/folders,/private/var/folders --allow-run=dolt schema/equivalence.ts"
  }
}
