{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dyfj:contracts:workbench:first-product:v1:views",
  "title": "Workbench first-product projections, receipts, and deferrals",
  "$defs": {
    "identifier": {
      "$ref": "urn:dyfj:contracts:workbench:first-product:v1:common#/$defs/identifier"
    },
    "tag": {
      "$ref": "urn:dyfj:contracts:workbench:first-product:v1:common#/$defs/tag"
    },
    "note": {
      "$ref": "urn:dyfj:contracts:workbench:first-product:v1:common#/$defs/note"
    },
    "digest": {
      "$ref": "urn:dyfj:contracts:workbench:first-product:v1:common#/$defs/digest"
    },
    "revision": {
      "$ref": "urn:dyfj:contracts:workbench:first-product:v1:common#/$defs/revision"
    },
    "labels": {
      "$ref": "urn:dyfj:contracts:workbench:first-product:v1:common#/$defs/labels"
    },
    "claim_source": {
      "$ref": "urn:dyfj:contracts:workbench:first-product:v1:common#/$defs/claim_source"
    },
    "evidence_item": {
      "$ref": "urn:dyfj:contracts:workbench:first-product:v1:common#/$defs/evidence_item"
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "identity_basis",
        "revision",
        "family",
        "source_packets",
        "source_events",
        "source_labels",
        "consumer_clearance",
        "output_digest",
        "rebuildable",
        "grants_authority"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "identity_basis": {
          "$ref": "urn:dyfj:contracts:workbench:first-product:v1:common#/$defs/identity_basis"
        },
        "revision": { "$ref": "#/$defs/revision" },
        "family": {
          "enum": ["conversation", "activity", "status", "inspector"]
        },
        "source_packets": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "source_events": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "source_labels": { "$ref": "#/$defs/labels" },
        "consumer_clearance": {
          "$ref": "urn:dyfj:contracts:workbench:first-product:v1:common#/$defs/clearance"
        },
        "output_digest": { "$ref": "#/$defs/digest" },
        "rebuildable": { "const": true },
        "grants_authority": { "const": false }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "claim_source", "evidence"],
      "properties": {
        "state": {
          "enum": [
            "asserted",
            "observed",
            "satisfied",
            "unsatisfied",
            "accepted",
            "rejected",
            "closed",
            "open",
            "absent"
          ]
        },
        "claim_source": { "$ref": "#/$defs/claim_source" },
        "evidence": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/evidence_item" }
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "amount_minor_units", "basis"],
      "properties": {
        "currency": { "$ref": "#/$defs/tag" },
        "amount_minor_units": { "type": "integer", "minimum": 0 },
        "basis": {
          "enum": [
            "metered-tokens",
            "subscription",
            "local-compute",
            "not-applicable"
          ]
        }
      }
    },
    "receipt_body": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "route": {
          "type": "object",
          "additionalProperties": false,
          "required": ["route", "reason"],
          "properties": {
            "route": { "$ref": "#/$defs/identifier" },
            "reason": { "$ref": "#/$defs/note" }
          }
        },
        "context_packet": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reference", "revision", "digest"],
          "properties": {
            "reference": { "$ref": "#/$defs/identifier" },
            "revision": { "$ref": "#/$defs/revision" },
            "digest": { "$ref": "#/$defs/digest" }
          }
        },
        "projection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reference", "revision"],
          "properties": {
            "reference": { "$ref": "#/$defs/identifier" },
            "revision": { "$ref": "#/$defs/revision" }
          }
        },
        "projected_payload_digest": { "$ref": "#/$defs/digest" },
        "capability_posture": {
          "type": "object",
          "additionalProperties": false,
          "required": ["report", "report_revision", "unavailable_required"],
          "description": "The revision binds the posture to the versioned report observation it was read from. Reports are immutable versioned observations in this package; no report history is persisted here.",
          "properties": {
            "report": { "$ref": "#/$defs/identifier" },
            "report_revision": { "$ref": "#/$defs/revision" },
            "unavailable_required": { "type": "boolean" }
          }
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input_tokens", "output_tokens"],
          "properties": {
            "input_tokens": { "type": "integer", "minimum": 0 },
            "output_tokens": { "type": "integer", "minimum": 0 }
          }
        },
        "cost": { "$ref": "#/$defs/cost" },
        "terminal_reason": { "$ref": "#/$defs/tag" },
        "task_revision": { "$ref": "#/$defs/revision" },
        "run_revision": { "$ref": "#/$defs/revision" },
        "route_evidence": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/evidence_item" }
        },
        "process_provenance": { "$ref": "#/$defs/identifier" },
        "tools_and_effects": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tool", "effect", "claim_source"],
            "properties": {
              "tool": { "$ref": "#/$defs/tag" },
              "effect": { "enum": ["none", "read", "write", "external"] },
              "claim_source": { "$ref": "#/$defs/claim_source" }
            }
          }
        },
        "artifacts": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "verification": { "$ref": "#/$defs/fact" },
        "preserved_state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "note"],
          "properties": {
            "kind": { "$ref": "#/$defs/tag" },
            "note": { "$ref": "#/$defs/note" }
          }
        },
        "outcome": {
          "enum": [
            "requested",
            "propagated",
            "acknowledged",
            "stopped",
            "uncertain"
          ]
        },
        "remaining_authority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["grant", "still_effective"],
          "properties": {
            "grant": { "$ref": "#/$defs/identifier" },
            "still_effective": { "type": "boolean" }
          }
        },
        "changes": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/note" }
        },
        "unresolved_risks": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/note" }
        },
        "facts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "agent_reported_completion",
            "workbench_observed_effects",
            "independent_verification",
            "operator_acceptance",
            "closure"
          ],
          "properties": {
            "agent_reported_completion": { "$ref": "#/$defs/fact" },
            "workbench_observed_effects": { "$ref": "#/$defs/fact" },
            "independent_verification": { "$ref": "#/$defs/fact" },
            "operator_acceptance": { "$ref": "#/$defs/fact" },
            "closure": { "$ref": "#/$defs/fact" }
          }
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "identity_basis",
        "revision",
        "schema_version",
        "family",
        "room",
        "commit_event",
        "attribution",
        "labels",
        "evidence",
        "observed_effects",
        "uncertainty",
        "next_action",
        "body"
      ],
      "description": "current_state is required for run, interrupt, and completion receipts, which always describe Task or Run lifecycle state. A turn receipt's primary subject is the conversational exchange: it carries current_state only when a Run is present to reconcile, and omits it rather than inventing a synthetic Run or a room/thread state machine when no Run participates.",
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "identity_basis": {
          "$ref": "urn:dyfj:contracts:workbench:first-product:v1:common#/$defs/identity_basis"
        },
        "revision": { "$ref": "#/$defs/revision" },
        "schema_version": { "const": "workbench.first-product.receipt/v1" },
        "family": { "enum": ["turn", "run", "interrupt", "completion"] },
        "room": { "$ref": "#/$defs/identifier" },
        "task": { "$ref": "#/$defs/identifier" },
        "run": { "$ref": "#/$defs/identifier" },
        "commit_event": { "$ref": "#/$defs/identifier" },
        "attribution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["author", "claim_source"],
          "properties": {
            "author": { "$ref": "#/$defs/identifier" },
            "authorizer": { "$ref": "#/$defs/identifier" },
            "claim_source": { "$ref": "#/$defs/claim_source" }
          }
        },
        "labels": { "$ref": "#/$defs/labels" },
        "payload": {
          "$ref": "urn:dyfj:contracts:workbench:first-product:v1:common#/$defs/payload"
        },
        "evidence": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/evidence_item" }
        },
        "observed_effects": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["effect", "claim_source"],
            "properties": {
              "effect": { "$ref": "#/$defs/tag" },
              "claim_source": { "$ref": "#/$defs/claim_source" },
              "note": { "$ref": "#/$defs/note" }
            }
          }
        },
        "uncertainty": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "note"],
          "properties": {
            "kind": { "enum": ["none", "bounded", "unresolved"] },
            "note": { "$ref": "#/$defs/note" }
          }
        },
        "current_state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entity_kind", "entity", "state", "revision"],
          "description": "The state and revision the receipt records for its subject, read at the sequence of its commit event rather than at the end of the corpus.",
          "properties": {
            "entity_kind": { "enum": ["task", "run"] },
            "entity": { "$ref": "#/$defs/identifier" },
            "state": {
              "$ref": "urn:dyfj:contracts:workbench:first-product:v1:common#/$defs/lifecycle_state"
            },
            "revision": { "$ref": "#/$defs/revision" }
          }
        },
        "next_action": { "$ref": "#/$defs/note" },
        "body": { "$ref": "#/$defs/receipt_body" }
      }
    },
    "deferral": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "capability",
        "status",
        "required",
        "implemented",
        "authoritative",
        "routable",
        "note"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "capability": { "$ref": "#/$defs/tag" },
        "status": { "const": "deferred" },
        "required": { "type": "boolean" },
        "implemented": { "type": "boolean" },
        "authoritative": { "type": "boolean" },
        "routable": { "type": "boolean" },
        "reserved_identifier": { "$ref": "#/$defs/tag" },
        "note": { "$ref": "#/$defs/note" }
      }
    }
  }
}
