{
  "schema": "dyfj.workbench.first-product.corpus/v1",
  "package_version": "workbench.first-product/v1",
  "profile": "focused-rule-fixture",
  "title": "A membership names a participant identifier where a room belongs",
  "expectation": {
    "outcome": "reject",
