      "labels": {
        "integrity_class": "attested",
        "secrecy_tags": [],
        "visibility": "room",
        "sensitivity": "low"
      }
    }
  ],
  "participants": [
    {
      "id": "participant-operator",
      "identity_basis": "assigned-opaque",
      "revision": 1,
      "participant_class": "human",
      "independent_of": [
        "model",
        "runner",
        "process",
        "user-interface"
      ]
    }
  ],
  "room_memberships": [
    {
      "id": "membership-focused",
